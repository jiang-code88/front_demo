            execute_sql_file(get_brand_dict_cursor(), file)

        table_fields = ['车型名称']
        query_vehiser_series_sql = '''
          SELECT
            '{{BRAND_EN}}_evo' as analyser,
            features ->> '$.brand' as brand,
            SUBSTRING_INDEX(SUBSTRING_INDEX(car_series, '/', 3), '/', -1) AS "车型名称",
            vehicle_model AS vehicle_model,
            '{}' AS features
          FROM
            epc_vehicle
          order by 3,4
        '''
        cursor = get_brand_dict_cursor()
        cursor.execute(query_vehiser_series_sql)
        vehicleSeries = cursor.fetchall()
        insertVehicleSeries(vehicleSeries, table_fields)

    if not step or step == 'mapping':
        cursor = get_brand_dict_cursor()

        with open(file="sql/v2_dc_parts_{{BRAND_EN}}.sql", mode="r", encoding="utf-8") as file:
            execute_sql_file(cursor, file)

        execute_sql(cursor, "select max(id) max_id from dc_parts_info_{{BRAND_EN}}_load;")
        max_id = cursor.fetchone()["max_id"]
        if not max_id:
            max_id = 0
        cursor.execute("SHOW COLUMNS FROM dc_parts_info_{{BRAND_EN}}_new")
        columns = [row["Field"] for row in cursor.fetchall()]
        filtered_columns = [col for col in columns if col != "id"]
        insert_column_list = ", ".join(filtered_columns)
        execute_sql(cursor, "truncate dc_parts_info_{{BRAND_EN}}_new;")
        execute_sql(cursor, f"ALTER TABLE dc_parts_info_{{BRAND_EN}}_new auto_increment = {max_id + 1}")
        execute_sql(cursor, f"""
            INSERT INTO dc_parts_info_{{BRAND_EN}}_new({insert_column_list})
            SELECT {insert_column_list}
            FROM dc_parts_info_{{BRAND_EN}}
            WHERE parts_id not in (SELECT parts_id from dc_parts_info_{{BRAND_EN}}_load);
        """)

        raw_data_check(2)
