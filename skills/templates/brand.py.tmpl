def get_brand_dict_cursor():
    return get_dict_cursor("{{BRAND_EN}}_evo")


def get_largest_date_dir():
    numeric_directories = []
    for entry in os.listdir(DATA_BASE_PATH):
        full_path = os.path.join(DATA_BASE_PATH, entry)
        if os.path.isdir(full_path) and entry.isdigit():
            numeric_directories.append(int(entry))
    if not numeric_directories:
        raise RuntimeError(f"{DATA_BASE_PATH} 下不存在数字日期目录")
    return str(max(numeric_directories))


def get_source_file_path(file_name):
    return os.path.join(DATA_BASE_PATH, get_largest_date_dir(), "data", file_name)


def get_cache_file_path(file_name):
    directory_path = os.path.join(DATA_CACHE_PATH, get_largest_date_dir(), "data")
    os.makedirs(directory_path, exist_ok=True)
    return os.path.join(directory_path, file_name)


def _write_source_to_cache_utf8(source_path, cache_path):
    last_error = None
    for encoding in ('utf-8', 'gbk'):
        try:
            with open(source_path, 'r', encoding=encoding, newline='') as file_in:
                with open(cache_path, 'w', encoding='utf-8', newline='') as file_out:
                    for line in file_in:
                        file_out.write(line)
            return
        except UnicodeDecodeError as e:
            last_error = e
    raise RuntimeError(
        f"无法将源文件转为 UTF-8：{source_path}（日期目录 {get_largest_date_dir()}），"
        f"已尝试编码：utf-8、gbk"
    ) from last_error


def prepare_cache_file(file_name):
    source_path = get_source_file_path(file_name)
    cache_path = get_cache_file_path(file_name)
    _write_source_to_cache_utf8(source_path, cache_path)
    distinct_csv_records(cache_path)
    return cache_path


def distinct_csv_records(file):
    backup = file + ".bak"
    seen = set()
    with open(file, 'r', encoding='utf-8', newline='') as infile, \
            open(backup, 'w', encoding='utf-8', newline='') as outfile:
        reader = csv.reader(infile)
        writer = csv.writer(outfile)
        for row in reader:
            row_tuple = tuple(row)
            if row_tuple not in seen:
                writer.writerow(row)
                seen.add(row_tuple)
    os.replace(backup, file)


