def detect_newline(path):
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(4096), b''):
            if b'\r\n' in chunk:
                return '\\r\\n'
            if b'\n' in chunk:
                return '\\n'
            if b'\r' in chunk:
                return '\\r'
    return None


def load(cursor, table_name, file_name, csv_field_names):
    file_path = prepare_cache_file(file_name)
    newline = detect_newline(file_path)
    print("newline:%s" % newline)
    load_local_data_infile_inner(cursor, file_path, table_name,
                                 ['`' + field_name + '`' for field_name in csv_field_names], True,
                                 True, newline)


def output_miss_data(writer, data, type, error_msg):
    result = []
    for d in data:
        result.append({
            "catalog": d['car_series'],
            "group_path": d['group_path_origin'],
            "group_name": d['group_name'],
            "group_image_id": d['group_image_id'],
            "group_level": d['group_level'],
            "error_type": type,
            "error_msg": error_msg
        })
    writer.writerows(result)


def raw_data_check(group_level):
    cursor = get_brand_dict_cursor()
    lack_sub_group_sql = '''
          SELECT DISTINCT
            C.car_series,
            A.group_path_origin,
            A.group_name,
            A.group_image_id,
            A.group_level
          FROM
            raw_group_data A
            LEFT JOIN raw_group_data B ON A.catalog = B.catalog
            AND A.group_path = B.parent_group_path
            JOIN epc_vehicle C ON c.vehicle_model = A.catalog
          WHERE
            A.group_level = 1
            AND B.id IS NULL;
    '''
    lack_parts_group_sql = '''
      SELECT DISTINCT
        C.car_series,
        A.group_path_origin,
        A.group_name,
        A.group_image_id,
        A.group_level
      FROM
        raw_group_data A
        LEFT JOIN raw_parts_data B ON A.catalog = B.catalog
        AND A.group_path = B.group_path
        JOIN epc_vehicle C ON c.vehicle_model = A.catalog
      WHERE
        A.group_level = {group_level}
        AND B.id IS NULL;
    '''

    lack_image_group_sql = '''
      SELECT DISTINCT
        C.car_series,
        A.group_path_origin,
        A.group_name,
        A.group_image_id,
        A.group_level
      FROM
        raw_group_data A
        LEFT JOIN epc_image_path B ON A.group_image_id = CONCAT(B.`originPath`, ".", B.originSuffix)
        JOIN epc_vehicle C ON C.vehicle_model = A.catalog
      WHERE B.id IS NULL
      AND A.group_level != 1
    '''
    lack_hotspot_group_sql = '''
      SELECT DISTINCT
        C.car_series,
        A.group_path_origin,
        A.group_name,
        A.group_image_id,
        A.group_level
      FROM
        raw_group_data A
        LEFT JOIN raw_hotspot_data h ON A.group_image_id = h.group_path
        JOIN epc_vehicle C on C.vehicle_model = A.catalog
      WHERE
        A.group_level = 2
        AND h.id IS NULL;
    '''

    cursor.execute(lack_sub_group_sql)
    result = cursor.fetchall()
    if not os.path.exists(DATA_CACHE_PATH):
        os.mkdir(DATA_CACHE_PATH)
    with open(os.path.join(DATA_CACHE_PATH, r'midss_data.csv'), 'w', encoding='utf-8', newline='') as csvfile:
        error_content_field_names = ['catalog', 'group_path', 'group_name', 'group_image_id', 'group_level',
                                     'error_type', 'error_msg']
        writer = csv.DictWriter(csvfile, fieldnames=error_content_field_names)
        writer.writeheader()
        output_miss_data(writer, result, 'no_sub_group', '无子组的组')
        cursor.execute(lack_parts_group_sql.format(group_level=group_level))
        result = cursor.fetchall()
        output_miss_data(writer, result, 'empty_parts', '无配件的组')
        cursor.execute(lack_image_group_sql)
        result = cursor.fetchall()
        output_miss_data(writer, result, 'lack_image', '缺少图片的组')
        cursor.execute(lack_hotspot_group_sql.format(group_level=group_level))
        result = cursor.fetchall()
        output_miss_data(writer, result, 'lack_hot_spot_data', '缺少热点数据的组')


