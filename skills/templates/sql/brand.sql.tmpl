                g.group_id,
                epc_parts_id,
                parts_position,
                parts_position,
                parts_quantity,
                parts_features,
                parts_order
FROM raw_group_data g
JOIN raw_parts_data r
WHERE g.group_path = r.group_path
and g.catalog = r.catalog;



