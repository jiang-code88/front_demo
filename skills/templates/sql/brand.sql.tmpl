UPDATE raw_ve SET catalog_origin = catalog;
UPDATE raw_group_data SET catalog_origin = catalog, group_path_origin = group_path;
UPDATE raw_parts_data SET catalog_origin = catalog, group_path_origin = group_path;
UPDATE raw_hotspot_data SET catalog_origin = catalog, group_path_origin = group_path;

UPDATE raw_parts_data SET parts_code=TRIM(UPPER(
        REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(parts_code,
        '!', ''), '@', ''),'#', ''), '$', ''), '%', ''), '^', ''), '&', ''),'*', ''), '(', ''), ')', ''), '-', '')
));

-- 清除不可见字符(换行符、制表符、回车符)
UPDATE raw_parts_data
SET parts_name = trim(REPLACE(REPLACE(REPLACE(IFNULL(parts_name, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));

UPDATE raw_parts_data
SET parts_position = trim(REPLACE(REPLACE(REPLACE(IFNULL(parts_position, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));

UPDATE raw_parts_data
SET parts_remark = trim(REPLACE(REPLACE(REPLACE(IFNULL(parts_remark, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));

UPDATE raw_group_data
SET group_name = trim(REPLACE(REPLACE(REPLACE(IFNULL(group_name, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));

UPDATE raw_group_data
SET group_no = trim(REPLACE(REPLACE(REPLACE(IFNULL(group_no, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));

UPDATE raw_group_data
SET group_desc = trim(REPLACE(REPLACE(REPLACE(IFNULL(group_desc, ''), CHAR(9), ''), CHAR(10), ''), CHAR(13), ''));


UPDATE raw_parts_data
SET parts_features = JSON_SET(
        COALESCE(parts_features, '{}'),
        '$.remark',
        parts_remark
                     );

truncate epc_image;
insert into epc_image(name, `desc`, uri)
select distinct group_image_id, group_image_uri, ''
from raw_group_data
where group_image_id != '';


UPDATE epc_image,epc_image_path
set uri=resultPath
where name = CONCAT(`originPath`,".",originSuffix);

update raw_group_data r ,epc_image i
set r.group_epc_image_id=i.id
where name = group_image_id
and group_image_uri = `desc`;

TRUNCATE epc_group;
-- 主组
INSERT INTO `epc_group`(`code`, `name`, `desc`, `parent_id`, `level`, `has_child`, `image_id`, `features`)
SELECT DISTINCT '',
                group_name,
                group_no,
                0,
                1,
                1,
                ifnull(group_epc_image_id,0),
                json_array(group_image_id)
FROM raw_group_data
where group_level = 1;


UPDATE raw_group_data raw ,epc_group g
set raw.group_id=g.id
WHERE g.name = raw.group_name
  and g.`desc` = raw.group_no
  and g.features = json_array(group_image_id)
  and g.level = 1
  and raw.group_level = 1;


UPDATE raw_group_data raw_p ,raw_group_data raw_g
set raw_g.parent_group_id=raw_p.group_id
WHERE raw_g.parent_group_path = raw_p.group_path
and raw_p.catalog = raw_g.catalog;

-- 图组
INSERT INTO `epc_group`(`code`, `name`, `desc`, `parent_id`, `level`, `has_child`, `image_id`, `features`)
SELECT DISTINCT g.group_no,
                g.group_name,
                g.group_desc,
                g.parent_group_id,
                2,
                0,
                ifnull(group_epc_image_id, 0),
                json_array(group_image_id)
FROM raw_group_data g
where g.group_level = 2;



UPDATE raw_group_data raw ,epc_group g
set raw.group_id=g.id
WHERE g.code = raw.group_no
  and g.name = raw.group_name
  and g.`desc` = raw.group_desc
  and g.features = json_array(group_image_id)
  and g.level = 2
  and g.parent_id = raw.parent_group_id
  and raw.group_level = 2;
;


