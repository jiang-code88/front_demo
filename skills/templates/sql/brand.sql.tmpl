and g.catalog = r.catalog
and r.group_id is NULL
and g.group_level=2;

truncate epc_parts;
INSERT INTO epc_parts(parts_code, origin_parts_code, epc_parts_name, remark, date_from, date_to, features)
SELECT distinct parts_code,
                parts_code,
                parts_name,
                '',
               '1000-01-01',
                '9999-12-31',
                parts_features
FROM raw_parts_data;


DROP procedure if exists pro_epc_parts;
# SQL PROCEDURE BEGIN #
CREATE  PROCEDURE `pro_epc_parts`()
begin
    DECLARE range_end int;
    DECLARE range_index int;
    DECLARE range_incrment int;
    set range_end = (SELECT MAX(id) from raw_parts_data);
    set range_index = 0;
    set range_incrment = 1000;

    REPEAT
        UPDATE raw_parts_data raw ,epc_parts p
        SET raw.epc_parts_id=p.id
    WHERE raw.parts_code = p.parts_code
		AND p.origin_parts_code = raw.parts_code
		AND p.epc_parts_name = raw.parts_name
		AND p.features = raw.parts_features
        AND raw.id >= range_index
        AND raw.id < range_index + range_incrment;
        SET range_index = range_index + range_incrment;
        COMMIT;
    UNTIL range_index > range_end END REPEAT;
end;
# SQL PROCEDURE FINISH #
;

call pro_epc_parts();

UPDATE epc_parts SET parts_code=common_evo.alphanum(parts_code);


