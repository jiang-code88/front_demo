CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_group_parts` LIKE `template_evo`.`epc_group_parts`;
CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_image` LIKE `template_evo`.`epc_image`;
CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_image_hotspot` LIKE `template_evo`.`epc_image_hotspot`;
CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_parts` LIKE `template_evo`.`epc_parts`;
CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_parts_id_epc_parts_id_relation` LIKE `template_evo`.`epc_parts_id_epc_parts_id_relation`;
CREATE TABLE IF NOT EXISTS `{{BRAND_EN}}_evo`.`epc_vehicle` LIKE `template_evo`.`epc_vehicle`;
